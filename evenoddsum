import java.util.*;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        int evendig=0;
        int odddig=0;
        for(int i=0;i<n;i++){
          if(arr[i]%2==0){
            evendig += arr[i];

          }
        
          else{
            odddig += arr[i];
          }
        }
        System.out.println(evendig);
         System.out.println(odddig);


}
}
